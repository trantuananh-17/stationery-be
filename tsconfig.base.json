{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "module": "node16",
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@common/constants/*": ["./libs/constants/src/lib/*"],
      "@common/configuration/*": ["./libs/configuration/src/lib/*"],
      "@common/middlewares/*": ["./libs/middlewares/src/lib/*"],
      "@common/utils/*": ["./libs/utils/src/lib/*"],
      "@common/interfaces/*": ["./libs/interfaces/src/lib/*"],
      "@common/interceptors/*": ["./libs/interceptors/src/lib/*"],
      "@common/decorators/*": ["./libs/decorators/src/lib/*"],
      "@common/databases/*": ["./libs/databases/src/lib/*"],
      "@common/guards/*": ["./libs/guards/src/lib/*"],
      "@common/filters/*": ["./libs/filters/src/lib/*"],
      "@common/kafka/*": ["./libs/kafka/src/lib/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
